{
  "schema_version": 5,
  "run_name": "bilinear_progressive_v1",
  "seed": 2407,
  "pair_roles": {
    "train": [
      "CS-r32_to_ICOD-r32",
      "ICOD-r32_to_CS-r32",
      "CS-r32_to_RLL-r90-180",
      "RLL-r90-180_to_CS-r32",
      "ICOD-r32_to_RLL-r90-180",
      "ICO-r32_to_CS-r32"
    ],
    "selection": ["CS-r64_to_ICOD-r64"],
    "protected": ["CS-r32_to_HP-n32", "ICOD-r32_to_HP-n32"],
    "external_resolution": [
      "CS-r128_to_ICOD-r128",
      "ICOD-r128_to_CS-r128"
    ]
  },
  "paths": {
    "analysis": "analysis_medium_improv",
    "maps": "maps_medium_improv",
    "models": "_next/checkpoints",
    "reports": "_next/reports",
