#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$ROOT_DIR"

if [[ -n "${REMAPGNN_PYTHON:-}" ]]; then
  if [[ "$REMAPGNN_PYTHON" == */* ]]; then
    [[ -x "$REMAPGNN_PYTHON" ]] || {
      echo "REMAPGNN_PYTHON is not executable: $REMAPGNN_PYTHON" >&2
      exit 2
    }
    PYTHON_BIN="$REMAPGNN_PYTHON"
  else
    PYTHON_BIN=$(command -v "$REMAPGNN_PYTHON") || {
      echo "REMAPGNN_PYTHON was not found on PATH: $REMAPGNN_PYTHON" >&2
      exit 2
    }
  fi
elif [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python" ]]; then
  PYTHON_BIN="$VIRTUAL_ENV/bin/python"
elif [[ -n "${CONDA_PREFIX:-}" && -x "$CONDA_PREFIX/bin/python" ]]; then
  PYTHON_BIN="$CONDA_PREFIX/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN=$(command -v python3)
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN=$(command -v python)
else
  echo "No Python interpreter found. Activate the project environment or set REMAPGNN_PYTHON." >&2
  exit 2
fi

if ! "$PYTHON_BIN" -B -c 'import numpy, torch' >/dev/null 2>&1; then
  echo "Selected Python lacks required packages: $PYTHON_BIN" >&2
  echo "Activate the project environment or set REMAPGNN_PYTHON to its Python executable." >&2
  exit 2
fi

export PYTHONPATH="$ROOT_DIR/_next${PYTHONPATH:+:$PYTHONPATH}"
CONFIG="$ROOT_DIR/_next/configs/progressive.json"
PRODUCTION_POINTER="$ROOT_DIR/_next/configs/production.json"
read -r PRODUCTION PRODUCTION_MANIFEST < <(
  "$PYTHON_BIN" -B -c 'import json,sys; p=json.load(open(sys.argv[1])); print(p["checkpoint"], p["manifest"])' \
    "$PRODUCTION_POINTER"
)

usage() {
  cat <<'EOF'
Clean remapping workflow

Usage:
  ./next status
  ./next test
  ./next smoke [training options]
  ./next train [training options]
  ./next resume [training options]
  ./next audit [audit options]
  ./next audit-candidate [audit options]
  ./next audit-protected [audit options]
  ./next compare list|run [comparison options]
  ./next baseline-check [baseline options]
  ./next build-fv PAIR OUTPUT [build options]

Common examples:
  ./next status
  ./next smoke
  ./next train
  ./next resume
  ./next audit --pairs CS-r64_to_ICOD-r64 ICO-r32_to_CS-r32

`audit` checks the approved converted checkpoint. `audit-candidate` checks the
latest trained candidate. Protected/large-resolution pairs require the explicit
`audit-protected` command.
EOF
}

command_name=${1:-help}
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  status)
    exec "$PYTHON_BIN" -B "$ROOT_DIR/_next/scripts/status.py" "$@"
    ;;
  test)
    exec "$PYTHON_BIN" -B -m pytest "$ROOT_DIR/_next/tests" -v
    ;;
  smoke)
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/train.py" \
      --config "$CONFIG" --device cuda --smoke "$@"
    ;;
  train)
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/train.py" \
      --config "$CONFIG" --device cuda "$@"
    ;;
  resume)
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/train.py" \
      --config "$CONFIG" --device cuda --resume "$@"
    ;;
  audit)
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/audit.py" \
      --config "$CONFIG" --device cuda --checkpoint "$PRODUCTION" \
      --manifest "$PRODUCTION_MANIFEST" --require-production "$@"
    ;;
  audit-candidate)
    if [[ "$*" != *"--config"* || "$*" != *"--checkpoint"* ]]; then
      echo "audit-candidate requires explicit --config and --checkpoint" >&2
      exit 2
    fi
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/audit.py" \
      --device cuda "$@"
    ;;
  audit-protected)
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/audit.py" \
      --config "$CONFIG" --device cuda --checkpoint "$PRODUCTION" \
      --manifest "$PRODUCTION_MANIFEST" --require-production --allow-protected "$@"
    ;;
  compare)
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/compare.py" "$@"
    ;;
  baseline-check)
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/check_bilinear.py" "$@"
    ;;
  build-fv)
    if [[ $# -lt 2 ]]; then
      echo "build-fv requires PAIR and OUTPUT" >&2
      usage >&2
      exit 2
    fi
    pair_name=$1
    output_path=$2
    shift 2
    exec "$PYTHON_BIN" -B -u "$ROOT_DIR/_next/scripts/build_fv.py" \
      --config "$CONFIG" --pair "$pair_name" --output "$output_path" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
